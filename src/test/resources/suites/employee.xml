<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
    EMPLOYEE SUITE.

    Employee directory, registration, form validation and departments.
    Selected by class rather than method name, so renaming or merging tests
    inside the class never silently drops them from this suite.

    Run with:  mvn clean test -Pemployee
-->
<suite name="MyWe HRMS - Employee Suite" verbose="1" parallel="false">

    <listeners>
        <listener class-name="com.mywehr.listeners.TestListener"/>
        <listener class-name="com.mywehr.listeners.RetryListener"/>
    </listeners>

    <test name="Employee" preserve-order="true">
        <classes>
            <class name="com.mywehr.tests.employee.EmployeeManagementTest"/>
        </classes>
    </test>

</suite>

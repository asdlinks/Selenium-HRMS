<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
    CONFIGURATION SUITE.

    Organization structure, company profile, attendance setup and reports.
    Selected by class rather than method name, so renaming or merging tests
    inside the class never silently drops them from this suite.

    Run with:  mvn clean test -Pconfiguration
-->
<suite name="MyWe HRMS - Configuration Suite" verbose="1" parallel="false">

    <listeners>
        <listener class-name="com.mywehr.listeners.TestListener"/>
        <listener class-name="com.mywehr.listeners.RetryListener"/>
    </listeners>

    <test name="Configuration" preserve-order="true">
        <classes>
            <class name="com.mywehr.tests.configuration.OrganizationConfigurationTest"/>
        </classes>
    </test>

</suite>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
    AUTHENTICATION SUITE.

    Login page, invalid credentials, persona sign-in and session boundaries.
    Selected by class rather than method name, so renaming or merging tests
    inside the class never silently drops them from this suite.

    Run with:  mvn clean test -Pauth
-->
<suite name="MyWe HRMS - Authentication Suite" verbose="1" parallel="false">

    <listeners>
        <listener class-name="com.mywehr.listeners.TestListener"/>
        <listener class-name="com.mywehr.listeners.RetryListener"/>
    </listeners>

    <test name="Authentication" preserve-order="true">
        <classes>
            <class name="com.mywehr.tests.auth.AuthenticationSmokeTest"/>
        </classes>
    </test>

</suite>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
    ALL DEMO SETS - flaky, healable, unhealable and normal-fail together.

    Part of the healing / flaky-detection demo - see FLAKY_HEALING_DEMO.md.
    RetryListener is deliberately NOT attached, so every failure shows on the
    first attempt instead of being hidden by a retry.

    Run with:  mvn clean test -Pdemo
-->
<suite name="MyWe HRMS - Demo - All" verbose="1" parallel="false">

    <listeners>
        <listener class-name="com.mywehr.listeners.TestListener"/>
    </listeners>

    <test name="Demo - All" preserve-order="true">
        <classes>
            <class name="com.mywehr.tests.leave.LeaveFlakyTest"/>
            <class name="com.mywehr.tests.leave.LeaveHealableTest"/>
            <class name="com.mywehr.tests.leave.LeaveBrokenTest"/>
        </classes>
    </test>

</suite>

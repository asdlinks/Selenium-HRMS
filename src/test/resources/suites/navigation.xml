<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
    NAVIGATION SUITE.

    Header, section rails and every module loading for each persona.
    Selected by class rather than method name, so renaming or merging tests
    inside the class never silently drops them from this suite.

    Run with:  mvn clean test -Pnavigation
-->
<suite name="MyWe HRMS - Navigation Suite" verbose="1" parallel="false">

    <listeners>
        <listener class-name="com.mywehr.listeners.TestListener"/>
        <listener class-name="com.mywehr.listeners.RetryListener"/>
    </listeners>

    <test name="Navigation" preserve-order="true">
        <classes>
            <class name="com.mywehr.tests.navigation.ModuleLoadSmokeTest"/>
        </classes>
    </test>

</suite>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
    BROKEN SET - always fails: UNHEALABLE_TC_* (no element to heal to / script bug) and NORMALFAIL_TC_* (wrong assertion).

    Part of the healing / flaky-detection demo - see FLAKY_HEALING_DEMO.md.
    RetryListener is deliberately NOT attached, so every failure shows on the
    first attempt instead of being hidden by a retry.

    Run with:  mvn clean test -Pbroken
-->
<suite name="MyWe HRMS - Demo - Broken" verbose="1" parallel="false">

    <listeners>
        <listener class-name="com.mywehr.listeners.TestListener"/>
    </listeners>

    <test name="Demo - Broken" preserve-order="true">
        <classes>
            <class name="com.mywehr.tests.leave.LeaveBrokenTest"/>
        </classes>
    </test>

</suite>
